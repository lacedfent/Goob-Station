<DefaultWindow xmlns="https://spacestation14.io"
            Title="{Loc 'spy-uplink-title'}"
            MinSize="380 300"
            SetSize="440 480">
    <BoxContainer Orientation="Vertical">
        <Label Name="Greeting"
               Text="{Loc 'spy-uplink-greeting'}"
               FontColorOverride="#8a8a8a" />
        <ScrollContainer
            Margin="0 6 0 0"
            HorizontalExpand="True"
            VerticalExpand="True">
            <BoxContainer Name="BountyList"
                          Orientation="Vertical"
                          HorizontalExpand="True" />
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>